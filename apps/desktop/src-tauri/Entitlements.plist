<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Needed once the app is signed with the hardened runtime (required for notarization): without it macOS
       refuses camera access even if the person allows it. Ignored for an unsigned build. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
