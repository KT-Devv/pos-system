{
  "name": "pos-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:tauri": "npm run tauri:dev --workspace=apps/desktop",
    "build:web": "npm run build --workspace=apps/web",
    "build:tauri": "npm run tauri:build --workspace=apps/desktop",
    "build:shared": "npm run build --workspace=packages/shared",
    "test": "npm run test:shared && npm run test:db",
    "test:shared": "npm test --workspace=packages/shared",
    "test:db": "node database/tests/run.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
